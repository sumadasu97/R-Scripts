################################################################################################
#This script generates volcano plots.
#Input Data should have 3 columns Gene Name,Log2foldchanges and pvalues
# If the genes need to be visualized adjust the scale according the up and down expression levels
##################################################################################################

###############################################
#Required Packages
###############################################
library(ggplot2)
library(ggrepel)

###########################################################
# File containing data to generate volcano plot
###########################################################

tmp <- read.csv('Volcano_Sample_TestData.csv', header = TRUE, sep = ",")
de <- tmp[complete.cases(tmp), ]
ggplot(data=de, aes(x=log2FoldChange, y=pvalue)) + geom_point()
p <- ggplot(data=de, aes(x=log2FoldChange, y=-log10(pvalue))) + geom_point()
p2 <- p + geom_vline(xintercept=c(-2, 2), col="red") +
    geom_hline(yintercept=-log10(0.05), col="red")

#####################################################################
#Set scale for up and regulated genes to make them visual on the plot
####################################################################
de$diffexpressed <- "NO"
de$diffexpressed[de$log2FoldChange >= 1.0] <- "UP"
de$diffexpressed[de$log2FoldChange <= -0.5] <- "DOWN"
p <- ggplot(data=de, aes(x=log2FoldChange, y=-log10(pvalue), col=diffexpressed)) + geom_point() + theme_minimal()
p3 <- p2 + scale_color_manual(values=c("blue", "black", "red"))
mycolors <- c("blue", "red", "black")
names(mycolors) <- c("DOWN", "UP", "NO")
p3 <- p2 + scale_colour_manual(values = mycolors)
de$delabel <- NA
de$delabel[de$diffexpressed != "NO"] <- de$Name[de$diffexpressed != "NO"]
ggplot(data=de, aes(x=log2FoldChange, y=-log10(pvalue), col=diffexpressed, label=delabel)) + 
    geom_point() + 
    theme_minimal() +
    geom_text()
ggplot(data=de, aes(x=log2FoldChange, y=-log10(pvalue), col=diffexpressed, label=delabel)) +
    geom_point() +
    geom_label_repel(box.padding = 0.2, max.overlaps = 30) +
     #labs(title = "max.overlaps = 20 (default)")
     scale_color_manual(values=c("blue", "black", "red")) +
    geom_vline(xintercept=c(-2, 2), col="red") +
     geom_hline(yintercept=-log10(0.05), col="red")+
     ggtitle("Study 2 WB IM Term")
